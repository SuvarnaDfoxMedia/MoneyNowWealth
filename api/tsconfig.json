{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "./dist",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "isolatedModules": true,
    "incremental": true
  },
  "include": ["src/**/*", "scripts"],
  "exclude": ["node_modules"]
}

